<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootRegistro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".RegistroActivity">

    <!-- Fondo decorativo de circuitos electrónicos -->
    <View
        android:id="@+id/fondoRegistro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/fondo_cintas_circuitos"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenido desplazable del registro -->
    <ScrollView
        android:id="@+id/contenidoRegistro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/piePaginaRegistro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Logo -->
            <ImageView
                android:id="@+id/ivLogoRegistro"
                android:layout_width="144dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:contentDescription="Logotipo de Electrónica 360"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_electronica360" />

            <!-- Nombre de la tienda -->
            <TextView
                android:id="@+id/tvNombreTiendaRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="ELECTRÓNICA 360"
                android:textColor="#12317B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Eslogan -->
            <TextView
                android:id="@+id/tvEsloganRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="REPARA. CREA. INNOVA."
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Línea separadora celeste -->
            <View
                android:id="@+id/separadorRegistro"
                android:layout_width="100dp"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="#79C9E6" />

            <!-- Título del registro -->
            <TextView
                android:id="@+id/tvTituloRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Crear cuenta"
                android:textColor="#12317B"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- Descripción -->
            <TextView
                android:id="@+id/tvDescripcionRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Completa los siguientes datos para registrarte."
                android:textColor="#52627D"
                android:textSize="14sp" />

            <!-- Tarjeta del formulario -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaFormularioRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeColor="#E1E9F5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Nombre completo -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombre completo"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#0085F7"
                        app:hintTextColor="#52627D">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="textPersonName"
                            android:autofillHints="name"
                            android:singleLine="true"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:textColor="#12317B"
                            android:textColorHint="#52627D"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Correo electrónico -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Correo electrónico"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#0085F7"
                        app:hintTextColor="#52627D">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCorreoRegistro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="textEmailAddress"
                            android:autofillHints="emailAddress"
                            android:singleLine="true"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:textColor="#12317B"
                            android:textColorHint="#52627D"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Contraseña (mínimo 6 caracteres)"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#0085F7"
                        app:hintTextColor="#52627D"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#52627D">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContrasenaRegistro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="textPassword"
                            android:autofillHints="newPassword"
                            android:singleLine="true"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:textColor="#12317B"
                            android:textColorHint="#52627D"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirmar contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Confirmar contraseña"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#0085F7"
                        app:hintTextColor="#52627D"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#52627D">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmarContrasena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="textPassword"
                            android:autofillHints="newPassword"
                            android:singleLine="true"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:textColor="#12317B"
                            android:textColorHint="#52627D"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mensajes de validación -->
                    <TextView
                        android:id="@+id/tvMensajeRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#B42318"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp"
                        android:visibility="gone" />

                    <!-- Botón para crear la cuenta -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegistrar"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="18dp"
                        android:text="CREAR CUENTA"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="#0085F7"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Enlace para volver al inicio de sesión -->
            <TextView
                android:id="@+id/tvVolverLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="¿Ya tienes una cuenta? Inicia sesión"
                android:textColor="#52627D"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

    <!-- Copyright con margen inferior de 4dp -->
    <TextView
        android:id="@+id/piePaginaRegistro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="© 2026 Electrónica 360."
        android:textColor="#52627D"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".LoginActivity">

    <!-- Fondo decorativo de circuitos electrónicos -->
    <View
        android:id="@+id/fondoLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/fondo_cintas_circuitos"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenido de inicio de sesión -->
    <ScrollView
        android:id="@+id/contenidoLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/piePagina"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Logo -->
            <ImageView
                android:id="@+id/ivLogoLogin"
                android:layout_width="144dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:contentDescription="Logotipo de Electrónica 360"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_electronica360" />

            <!-- Nombre de la tienda -->
            <TextView
                android:id="@+id/tvNombreTiendaLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="ELECTRÓNICA 360"
                android:textColor="#12317B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Eslogan -->
            <TextView
                android:id="@+id/tvEsloganLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="REPARA. CREA. INNOVA."
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Línea separadora celeste -->
            <View
                android:id="@+id/separadorLogin"
                android:layout_width="100dp"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="#79C9E6" />

            <!-- Título -->
            <TextView
                android:id="@+id/tvTituloLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Iniciar sesión"
                android:textColor="#12317B"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- Descripción -->
            <TextView
                android:id="@+id/tvDescripcionLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Accede a tu cuenta para continuar."
                android:textColor="#52627D"
                android:textSize="14sp" />

            <!-- Tarjeta del formulario -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaFormularioLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeColor="#E1E9F5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Correo electrónico -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Correo electrónico"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#0085F7"
                        app:hintTextColor="#52627D">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="58dp"
                            android:inputType="textEmailAddress"
                            android:autofillHints="emailAddress"
                            android:singleLine="true"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:textColor="#12317B"
                            android:textColorHint="#52627D"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:hint="Contraseña"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#0085F7"
                        app:hintTextColor="#52627D"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#52627D">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContrasena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="58dp"
                            android:inputType="textPassword"
                            android:autofillHints="password"
                            android:singleLine="true"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:textColor="#12317B"
                            android:textColorHint="#52627D"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mensajes de validación -->
                    <TextView
                        android:id="@+id/tvMensaje"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#B42318"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp"
                        android:visibility="gone" />

                    <!-- Botón de inicio de sesión -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIniciarSesion"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="30dp"
                        android:text="INICIAR SESIÓN"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="#0085F7"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Enlace de registro con área táctil mínima de 48dp -->
            <TextView
                android:id="@+id/tvIrRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="¿No tienes una cuenta? Regístrate"
                android:textColor="#52627D"
                android:textSize="14sp"
                android:textStyle="normal"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

    <!-- Copyright con margen inferior de 4dp -->
    <TextView
        android:id="@+id/piePagina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="© 2026 Electrónica 360."
        android:textColor="#52627D"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
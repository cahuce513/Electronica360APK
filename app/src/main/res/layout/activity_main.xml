<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@android:color/white">

    <!-- Fondo decorativo con circuitos electrónicos -->
    <View
        android:id="@+id/fondoDecorativo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/fondo_cintas_circuitos"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenido principal desplazable -->
    <ScrollView
        android:id="@+id/contenidoPrincipal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/piePagina"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Logo de Electrónica 360 -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="144dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:contentDescription="Logo de Electrónica 360"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_electronica360" />

            <!-- Nombre de la tienda -->
            <TextView
                android:id="@+id/txtNombreTienda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="ELECTRÓNICA 360"
                android:textColor="#12317B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Eslogan: azul coherente con las otras pantallas -->
            <TextView
                android:id="@+id/txtEslogan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="REPARA. CREA. INNOVA."
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Separador: celeste suave -->
            <View
                android:id="@+id/separadorPrincipal"
                android:layout_width="100dp"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="9dp"
                android:background="#79C9E6" />

            <!-- Descripción de la tienda -->
            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Repuestos, componentes y suministros electrónicos para tus reparaciones y proyectos."
                android:textColor="#374151"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <!-- Imagen principal de componentes electrónicos -->
            <ImageView
                android:id="@+id/imgComponentes"
                android:layout_width="match_parent"
                android:layout_height="255dp"
                android:layout_marginTop="5dp"
                android:contentDescription="Componentes electrónicos"
                android:scaleType="fitCenter"
                android:src="@drawable/componentes_electronicos" />

            <!-- Título de categorías -->
            <TextView
                android:id="@+id/txtTituloCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="9dp"
                android:gravity="center"
                android:text="ENCUENTRA LO QUE NECESITAS"
                android:textColor="#12317B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Tarjetas de categorías -->
            <LinearLayout
                android:id="@+id/contenedorCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3">

                <!-- Repuestos -->
                <LinearLayout
                    android:id="@+id/tarjetaRepuestos"
                    android:layout_width="0dp"
                    android:layout_height="102dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/fondo_tarjeta_categoria"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Repuestos electrónicos"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icono_repuestos" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Repuestos"
                        android:textColor="#12317B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Componentes -->
                <LinearLayout
                    android:id="@+id/tarjetaComponentes"
                    android:layout_width="0dp"
                    android:layout_height="102dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/fondo_tarjeta_categoria"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Componentes electrónicos"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icono_componentes" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Componentes"
                        android:textColor="#12317B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Herramientas -->
                <LinearLayout
                    android:id="@+id/tarjetaHerramientas"
                    android:layout_width="0dp"
                    android:layout_height="102dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/fondo_tarjeta_categoria"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Herramientas electrónicas"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icono_herramientas" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Herramientas"
                        android:textColor="#12317B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Botón para explorar el catálogo -->
            <LinearLayout
                android:id="@+id/btnContinuar"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/fondo_boton_catalogo"
                android:backgroundTint="#0085F7"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="EXPLORAR CATÁLOGO"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Accede a todos los productos"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Copyright: sin desplazamiento que lo corte abajo -->
    <TextView
        android:id="@+id/piePagina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="© 2026 Electrónica 360."
        android:textColor="#52627D"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>